# Rappi
# Bearer token capturado desde DevTools (Authorization header)
RAPPI_TOKEN=ft.gAAAA...
# Device ID capturado desde DevTools (deviceid header)
RAPPI_DEVICE_ID=00000000-0000-0000-0000-000000000000

# Uber Eats
# Cookie string completo capturado desde DevTools → Application → Cookies
# Ejemplo: "uev2.id.session_v2=xxx; dId=yyy; ..."
UBEREATS_COOKIE_STRING=

# Coordenadas de la ubicación de entrega (Culiacán por defecto)
DEFAULT_LAT=24.8143484
DEFAULT_LNG=-107.4005298
